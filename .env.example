# Application
APP_URL=http://localhost:3000
NODE_ENV=development
SESSION_COOKIE_NAME=our_big_day_session
# Generate a unique, random secret of at least 32 bytes and keep it stable.
MEMBER_INVITATION_SECRET=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/our-big-day?retryWrites=true&w=majority

# Resend
RESEND_API_KEY=
EMAIL_FROM=Our Big Day <noreply@example.com>

# Cloudflare R2 (server-side only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Places (server-side only)
GOOGLE_PLACES_API_KEY=

# Vercel Cron authentication
CRON_SECRET=
